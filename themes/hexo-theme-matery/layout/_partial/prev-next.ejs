<style>
    .prev-next-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 30px 0;
        padding: 0 15px;
    }
    .prev-btn, .next-btn {
        display: inline-flex;
        align-items: center;
        padding: 10px 20px;
        border-radius: 25px;
        text-decoration: none;
        font-size: 14px;
        transition: all 0.3s ease;
    }
    .prev-btn {
        margin-right: auto;
    }
    .next-btn {
        margin-left: auto;
    }
    .prev-btn.enabled, .next-btn.enabled {
        background-color: #3f51b5;
        color: white;
    }
    .prev-btn.enabled:hover, .next-btn.enabled:hover {
        background-color: #303f9f;
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
    }
    .prev-btn.disabled, .next-btn.disabled {
        background-color: #e0e0e0;
        color: #9e9e9e;
        cursor: not-allowed;
        pointer-events: none;
    }
    .prev-btn i {
        margin-right: 8px;
    }
    .next-btn i {
        margin-left: 8px;
    }
</style>

<div class="prev-next-nav">
    <% if (page.prev) { %>
    <a href="<%- url_for(page.prev.path) %>" class="prev-btn enabled">
        <i class="fas fa-chevron-left"></i>
        <span><%= __('prev') %>: <%= page.prev.title %></span>
    </a>
    <% } else { %>
    <span class="prev-btn disabled">
        <i class="fas fa-chevron-left"></i>
        <span><%= __('prev') %>: 没有了</span>
    </span>
    <% } %>

    <% if (page.next) { %>
    <a href="<%- url_for(page.next.path) %>" class="next-btn enabled">
        <span><%= __('next') %>: <%= page.next.title %></span>
        <i class="fas fa-chevron-right"></i>
    </a>
    <% } else { %>
    <span class="next-btn disabled">
        <span><%= __('next') %>: 没有了</span>
        <i class="fas fa-chevron-right"></i>
    </span>
    <% } %>
</div>
